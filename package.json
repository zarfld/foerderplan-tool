{
	"name": "foerderplan-tool",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "vite build",
		"build:pwa": "node scripts/build-pwa.bat",
		"dev": "vite dev --host",
		"dev:network": "vite dev --host 0.0.0.0 --port 5173",
		"preview": "vite preview",
		"preview:network": "vite preview --host 0.0.0.0 --port 4173",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:pwa": "playwright test --grep=\"PWA\"",
		"test:android": "playwright test --project=\"Mobile Chrome\""
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^9.6.0",
		"@types/node": "^24.3.1",
		"@types/pouchdb": "^6.4.2",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.0.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"type": "module",
	"dependencies": {
		"@vite-pwa/sveltekit": "^0.4.0",
		"chart.js": "^4.5.0",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"http-proxy-middleware": "^3.0.7",
		"jspdf": "^4.2.1",
		"pouchdb": "^8.0.1",
		"pouchdb-adapter-http": "^9.0.0",
		"pouchdb-adapter-idb": "^8.0.1",
		"pouchdb-authentication": "^1.1.3",
		"workbox-window": "^7.0.0"
	}
}
